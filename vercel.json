{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/profile.html",
      "destination": "/khoahocfoodapp/profile.html",
      "permanent": true
    },
    {
      "source": "/saleapp/",
      "destination": "/khoahocfoodapp/",
      "permanent": true
    },
    {
      "source": "/saleapp/:path*",
      "destination": "/khoahocfoodapp/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "fbclid"
        }
      ],
      "destination": "/khoahocfoodapp/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "ttclid"
        }
      ],
      "destination": "/khoahocfoodapp/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "gclid"
        }
      ],
      "destination": "/khoahocfoodapp/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "gbraid"
        }
      ],
      "destination": "/khoahocfoodapp/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "wbraid"
        }
      ],
      "destination": "/khoahocfoodapp/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
